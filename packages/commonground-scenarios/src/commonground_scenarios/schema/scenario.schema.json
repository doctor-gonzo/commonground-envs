{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commonground:schema:scenario:5",
  "title": "Common Ground planted policy scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "organization",
    "factions",
    "documents",
    "planted_items",
    "distractors",
    "persona_panel",
    "human_feedback",
    "provenance"
  ],
  "properties": {
    "scenario_id": {"$ref": "#/$defs/identifier"},
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sector", "fictional"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sector": {"type": "string", "minLength": 1},
        "fictional": {"type": "boolean"}
      }
    },
    "factions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/faction"}
    },
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/document"}
    },
    "planted_items": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/plantedItem"}
    },
    "distractors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/distractor"}
    },
    "persona_panel": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["vote_rule", "pass_threshold", "faction_ids"],
          "properties": {
            "vote_rule": {"const": "value-composition-v2"},
            "pass_threshold": {"const": 0.25},
            "faction_ids": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/identifier"}}
          }
        }
      ]
    },
    "human_feedback": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/contextEngineSnapshot"}
      ]
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {"synthetic": {"const": true}},
            "required": ["synthetic"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "organization": {"properties": {"fictional": {"const": true}}},
          "persona_panel": {"type": "object"},
          "human_feedback": {"type": "null"},
          "provenance": {
            "properties": {"generation_mode": {"enum": ["template", "operator-polished"]}}
          }
        }
      },
      "else": {
        "properties": {
          "organization": {"properties": {"fictional": {"const": false}}},
          "persona_panel": {"type": "null"},
          "human_feedback": {"$ref": "#/$defs/contextEngineSnapshot"},
          "provenance": {"properties": {"generation_mode": {"const": "human"}}}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faction_id", "name", "summary", "values"],
      "properties": {
        "faction_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access", "adaptability", "continuity", "oversight", "safety"],
          "properties": {
            "access": {"type": "number", "minimum": -1, "maximum": 1},
            "adaptability": {"type": "number", "minimum": -1, "maximum": 1},
            "continuity": {"type": "number", "minimum": -1, "maximum": 1},
            "oversight": {"type": "number", "minimum": -1, "maximum": 1},
            "safety": {"type": "number", "minimum": -1, "maximum": 1}
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "title", "style", "text"],
      "properties": {
        "doc_id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "plantedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plant_id", "doc_id", "anchor_quote", "type", "canonical_question", "decision", "decision_aliases", "value_weights", "alternative_stances", "canonical_yes_choice", "target_stances", "decision_value", "related_evidence"],
      "properties": {
        "plant_id": {"$ref": "#/$defs/identifier"},
        "doc_id": {"$ref": "#/$defs/identifier"},
        "anchor_quote": {"type": "string", "minLength": 1},
        "type": {"enum": ["ambiguity", "contradiction", "gap"]},
        "canonical_question": {
          "type": "string",
          "pattern": "^(Am|Are|Can|Could|Did|Do|Does|Had|Has|Have|Is|May|Might|Must|Shall|Should|Was|Were|Will|Would) [^\\s?]+(?: [^\\s?]+)*\\?(?![\\s\\S])"
        },
        "decision": {"$ref": "#/$defs/decisionFrame"},
        "decision_aliases": {"$ref": "#/$defs/decisionAliases"},
        "value_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access", "adaptability", "continuity", "oversight", "safety"],
          "properties": {
            "access": {"type": "number", "minimum": -1, "maximum": 1},
            "adaptability": {"type": "number", "minimum": -1, "maximum": 1},
            "continuity": {"type": "number", "minimum": -1, "maximum": 1},
            "oversight": {"type": "number", "minimum": -1, "maximum": 1},
            "safety": {"type": "number", "minimum": -1, "maximum": 1}
          }
        },
        "alternative_stances": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"enum": ["agree", "disagree", "pass"]}
        },
        "canonical_yes_choice": {"enum": ["anchor", "alternative"]},
        "target_stances": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {"enum": ["agree", "disagree", "pass"]}
        },
        "decision_value": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "related_evidence": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["doc_id", "quote"],
              "properties": {
                "doc_id": {"$ref": "#/$defs/identifier"},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "decisionFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "condition", "anchor_outcome", "alternative_outcome"],
      "properties": {
        "actor": {"type": "string", "minLength": 1, "maxLength": 240},
        "action": {"type": "string", "minLength": 1, "maxLength": 240},
        "condition": {"type": "string", "minLength": 1, "maxLength": 240},
        "anchor_outcome": {"type": "string", "minLength": 1, "maxLength": 240},
        "alternative_outcome": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "decisionAliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "condition", "anchor_outcome", "alternative_outcome"],
      "properties": {
        "actor": {"$ref": "#/$defs/decisionAliasList"},
        "action": {"$ref": "#/$defs/decisionAliasList"},
        "condition": {"$ref": "#/$defs/decisionAliasList"},
        "anchor_outcome": {"$ref": "#/$defs/decisionAliasList"},
        "alternative_outcome": {"$ref": "#/$defs/decisionAliasList"}
      }
    },
    "decisionAliasList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "distractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "anchor_quote", "reason"],
      "properties": {
        "doc_id": {"$ref": "#/$defs/identifier"},
        "anchor_quote": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "template_id", "template_set", "generated_at", "synthetic", "generation_mode", "generator_family"],
      "properties": {
        "seed": {"type": "integer"},
        "template_id": {"$ref": "#/$defs/identifier"},
        "template_set": {"enum": ["train", "heldout"]},
        "generated_at": {"type": "string", "format": "date"},
        "synthetic": {"type": "boolean"},
        "generation_mode": {"enum": ["template", "operator-polished", "human"]},
        "generator_family": {"$ref": "#/$defs/identifier"}
      }
    },
    "contextEngineSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "statements", "participants", "votes", "masked_cells", "held_out", "clusters", "stats", "meta"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "participants": {
          "type": "array",
          "minItems": 5,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^p[0-9]{3,}$"}
        },
        "votes": {"type": "array", "minItems": 5, "maxItems": 10000, "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"enum": [-1, 0, 1, null]}}},
        "masked_cells": {"type": "array", "maxItems": 0},
        "held_out": {"type": "object", "maxProperties": 0},
        "clusters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "members", "member_indices", "center"],
            "properties": {
              "id": {"type": "integer"},
              "members": {"type": "array", "minItems": 5, "items": {"type": "string", "pattern": "^p[0-9]{3,}$"}},
              "member_indices": {"type": "array", "minItems": 5, "items": {"type": "integer", "minimum": 0}},
              "center": {"type": "array", "maxItems": 0}
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comment"],
          "properties": {
            "comment": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commentIndex", "agrees", "disagrees", "unsure", "total", "responded", "extremity", "divisiveness"],
                "properties": {
                  "commentIndex": {"type": "integer", "minimum": 0},
                  "agrees": {"type": "integer", "minimum": 0},
                  "disagrees": {"type": "integer", "minimum": 0},
                  "unsure": {"type": "integer", "minimum": 0},
                  "total": {"type": "integer", "minimum": 0},
                  "responded": {"type": "integer", "minimum": 0},
                  "extremity": {"type": "null"},
                  "divisiveness": {"type": "null"}
                }
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["synthetic", "k_anonymity", "source", "seed", "consent_scope", "redistribution_rights_approved", "schema_version", "exporter_version", "source_commit", "privacy_review"],
          "properties": {
            "synthetic": {"const": false},
            "k_anonymity": {"type": "integer", "minimum": 5},
            "source": {"const": "context-engine-session"},
            "seed": {"type": "integer"},
            "consent_scope": {"const": "public-benchmark"},
            "redistribution_rights_approved": {"const": true},
            "schema_version": {"const": "commonground-human-snapshot-v2"},
            "exporter_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"},
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "privacy_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attested", "reviewed_at", "checks"],
              "properties": {
                "attested": {"const": true},
                "reviewed_at": {"type": "string", "format": "date"},
                "checks": {
                  "const": ["direct-identifiers", "free-text", "participant-pseudonyms"]
                }
              }
            }
          }
        }
      }
    }
  }
}
